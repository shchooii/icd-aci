# 이 파일을 demo.env 로 복사해 값만 고치면 demo.sh 가 읽습니다. (demo.env 는 git 에 올라가지 않습니다)

# 돌릴 단계.
#   ERG: 추출 -> 후보 검색 -> 코드 선택. 생성 모델과 재정렬 모델이 필요합니다(24GB GPU 두 장).
#   G:   코드 선택만. 생성 모델만 있으면 됩니다(GPU 한 장).
ICD_DEMO_PIPELINE=ERG

# 생성 모델을 서비스하는 OpenAI 호환 주소. 이 서버 안이나 사설망 주소만 허용됩니다.
ICD_DEMO_LLM_URL=http://127.0.0.1:8000/v1

# 모델 이름. 비워 두면 위 주소의 /v1/models 가 알려 주는 첫 모델을 씁니다.
ICD_DEMO_LLM_MODEL=

# 모델 서비스가 키를 요구할 때만 적습니다.
ICD_DEMO_LLM_API_KEY=

# 재정렬 서비스(server/rerank_service.py)의 주소와 키. ERG 일 때만 씁니다.
ICD_DEMO_RERANK_URL=http://127.0.0.1:8766
ICD_DEMO_RERANK_API_KEY=

# 데모 서버가 듣는 주소. 127.0.0.1 이면 SSH 터널로만 들어올 수 있습니다.
ICD_DEMO_HOST=127.0.0.1
ICD_DEMO_PORT=8765

# 접근 토큰. 기본은 쓰지 않습니다: 켜져 있으면 연결된 사람은 누구나 쓰고, 끄면 아무도 못 씁니다.
# 1로 바꾸면 토큰이 든 링크(sh server/demo.sh link)로 연 브라우저만 쓸 수 있습니다.
ICD_DEMO_REQUIRE_TOKEN=0

# 이 서버를 불러도 되는 페이지 주소(쉼표로 구분).
ICD_DEMO_ORIGINS=https://icd-coding.netlify.app

# 페이지에서 따로 고르지 않았을 때의 실행 방식.
#   full: 실험과 같은 설정으로 추론한 뒤 답한다(보통 2~3분).  fast: 추론을 생략한다(수십 초, 정확도는 확인하지 않음).
ICD_DEMO_DEFAULT_MODE=full

# 판독문 최대 글자 수, 동시에 받아 둘 건수
ICD_DEMO_MAX_NOTE_CHARS=20000
ICD_DEMO_QUEUE_MAX=8

# 실행 방식별 응답 최대 토큰 수와 한 건의 제한 시간(초)
ICD_DEMO_MAX_TOKENS=16384
ICD_DEMO_TIMEOUT_S=600
ICD_DEMO_FAST_MAX_TOKENS=4096
ICD_DEMO_FAST_TIMEOUT_S=180

# 판독문 요청이 이만큼(분) 없으면 서버가 스스로 꺼집니다. 0이면 꺼지지 않습니다.
ICD_DEMO_IDLE_EXIT_MIN=60

# (선택) 모델 서비스(생성 모델, 재정렬 모델)를 데모 서버와 같이 켜고 끄는 명령. 비워 두면 모델 서비스는 건드리지 않습니다.
# 시작 명령은 바로 돌아와야 합니다(모델을 백그라운드로 띄우는 스크립트 등). 띄어쓰기가 있으면 작은따옴표로 감쌉니다.
# 예: ICD_DEMO_MODEL_START_CMD='sh /경로/start_model.sh'
# 중지 명령은 demo.sh stop, run 종료, 자동 종료 때 실행됩니다.
ICD_DEMO_MODEL_START_CMD=
ICD_DEMO_MODEL_STOP_CMD=
